# TOPdesk MCP Server Configuration

# Required: TOPdesk instance base URL
TOPDESK_BASE_URL=https://your-tenant.topdesk.net

# Required: TOPdesk API token
# Get this from TOPdesk Settings > API > Application passwords
TOPDESK_API_TOKEN=your-api-token-here

# Optional: Path to OpenAPI specification file
# If not provided, the server will use the built-in manual endpoint registry
# TOPDESK_OPENAPI_PATH=/path/to/topdesk-openapi.json

# Optional: Enable debug logging (without secrets)
# DEBUG=true
